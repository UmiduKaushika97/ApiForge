// 


{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "rootDir": "./src",
    "outDir": "./out",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node", "vscode"],
    "jsx": "react-jsx"
  },
  "include": ["src/extension.ts"],
  "exclude": [
    "node_modules",
    "out",
    "media",
    "src/webview",
    "vite.config.ts",
    "tailwind.config.js",
    "postcss.config.js"
  ]
}
